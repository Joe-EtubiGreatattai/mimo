{
  "name": "mimo",
  "productName": "Mimo",
  "version": "1.5.0",
  "description": "A friendly tray dog that watches your free space and cleans up before you run out.",
  "author": "Great Attai",
  "homepage": "https://joe-etubigreatattai.github.io/mimo/",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "test": "node test/engine.test.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "6.6.2",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.great.mimo",
    "productName": "Mimo",
    "copyright": "Great Attai",
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Mimo-Setup.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mimo",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Joe-EtubiGreatattai",
        "repo": "mimo",
        "releaseType": "release"
      }
    ]
  }
}
